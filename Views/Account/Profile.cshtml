
@model MotoFix.Models.ProfileViewModel

@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <!-- Encabezado -->
            <div class="mb-4">
                <span class="badge rounded-pill px-3 py-2 mb-3"
                      style="background-color: #e8f0ff; color: #2457c5;">
                    <i class="bi bi-person-circle me-1"></i>
                    Cuenta personal
                </span>

                <h1 class="fw-bold mb-2" style="color: #172554;">
                    Mi perfil
                </h1>

                <p class="text-muted mb-0">
                    Consulta y actualiza tu información personal de MotoFix.
                </p>
            </div>

            <!-- Tarjeta principal -->
            <div class="card border-0 shadow-sm"
                 style="border-radius: 16px; overflow: hidden;">

                <div class="p-4 text-white"
                     style="background: linear-gradient(120deg, #172554, #2563eb);">

                    <div class="d-flex align-items-center gap-3">

                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 65px; height: 65px; background-color: rgba(255,255,255,.18);">

                            <i class="bi bi-person-fill fs-2"></i>

                        </div>

                        <div>
                            <h4 class="fw-bold mb-1">Información de usuario</h4>
                            <p class="mb-0 small text-white-50">
                                Mantén tus datos actualizados
                            </p>
                        </div>

                    </div>
                </div>

                <div class="card-body p-4 p-md-5">

                    <form asp-controller="Account"
                          asp-action="Profile"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <h5 class="fw-bold mb-1" style="color: #172554;">
                            Datos personales
                        </h5>

                        <p class="text-muted small mb-4">
                            Actualiza los campos que necesites modificar.
                        </p>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Nombre"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-person text-primary"></i>
                                    </span>

                                    <input asp-for="Nombre"
                                           class="form-control"
                                           placeholder="Ingresa tu nombre" />
                                </div>

                                <span asp-validation-for="Nombre"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Apellido"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-person text-primary"></i>
                                    </span>

                                    <input asp-for="Apellido"
                                           class="form-control"
                                           placeholder="Ingresa tu apellido" />
                                </div>

                                <span asp-validation-for="Apellido"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-12 mb-4">

                                <label asp-for="Email"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-envelope text-primary"></i>
                                    </span>

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="correo@ejemplo.com" />
                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4 py-2 fw-semibold">
                                <i class="bi bi-save me-2"></i>
                                Guardar cambios
                            </button>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4 py-2">
                                <i class="bi bi-arrow-left me-2"></i>
                                Volver al inicio
                            </a>

                        </div>

                    </form>

                </div>
            </div>

            <div class="text-center mt-4">
                <small class="text-muted">
                    <i class="bi bi-shield-check me-1"></i>
                    Tu información personal está protegida por MotoFix.
                </small>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
