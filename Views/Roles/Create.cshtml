
@model MotoFix.Models.CreateRoleViewModel

@{
    ViewData["Title"] = "Crear rol";
}

<style>
    .role-create-page {
        padding-top: 30px;
        padding-bottom: 40px;
    }

    .role-create-header {
        margin-bottom: 25px;
    }

    .role-create-header h2 {
        color: #172554;
        font-weight: 750;
        margin-bottom: 6px;
    }

    .role-create-header p {
        color: #64748b;
        margin-bottom: 0;
    }

    .role-create-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .06);
    }

    .role-create-card-header {
        background: linear-gradient(135deg, #172554, #1e40af);
        color: white;
        padding: 23px 27px;
    }

    .role-create-card-header h4 {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .role-create-card-header p {
        color: #bfdbfe;
        margin: 0;
        font-size: .9rem;
    }

    .role-create-card-body {
        padding: 28px;
    }

    .role-create-section-title {
        color: #172554;
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e2e8f0;
    }

    .role-create-label {
        color: #334155;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .role-create-control {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 11px 13px;
        transition: border-color .2s, box-shadow .2s;
    }

    .role-create-control:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, .13);
    }

    .role-create-help {
        color: #64748b;
        font-size: .83rem;
        margin-top: 7px;
    }

    .role-create-info {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 9px;
        padding: 13px 15px;
        color: #1e40af;
        font-size: .85rem;
        margin-bottom: 22px;
    }

    .permission-card {
        height: 100%;
        background: #fff;
        border: 1px solid #dbe3ef;
        border-radius: 11px;
        padding: 16px;
        transition: border-color .2s, background .2s, box-shadow .2s;
    }

    .permission-card:hover {
        border-color: #93c5fd;
        background: #f8fbff;
        box-shadow: 0 3px 10px rgba(37, 99, 235, .06);
    }

    .permission-card .form-check {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding-left: 0;
        margin: 0;
    }

    .permission-card .form-check-input {
        float: none;
        margin: 3px 0 0;
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        cursor: pointer;
    }

    .permission-card .form-check-input:checked {
        background-color: #2563eb;
        border-color: #2563eb;
    }

    .permission-card .form-check-label {
        cursor: pointer;
        width: 100%;
    }

    .permission-name {
        display: block;
        color: #172554;
        font-weight: 650;
        margin-bottom: 5px;
    }

    .permission-description {
        display: block;
        color: #64748b;
        font-size: .82rem;
        line-height: 1.5;
    }

    .permission-counter {
        background: #dbeafe;
        color: #1d4ed8;
        font-size: .8rem;
        font-weight: 650;
        padding: 5px 10px;
        border-radius: 20px;
    }

    .role-create-submit {
        background: #2563eb;
        border: none;
        border-radius: 9px;
        color: white;
        padding: 12px 20px;
        font-weight: 650;
        transition: background .2s, transform .2s;
    }

    .role-create-submit:hover {
        background: #1d4ed8;
        transform: translateY(-1px);
    }

    .role-create-cancel {
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        color: #475569;
        background: white;
        padding: 12px 20px;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s;
    }

    .role-create-cancel:hover {
        background: #f1f5f9;
        color: #172554;
    }

    @@media (max-width: 576px) {
        .role-create-card-body {
            padding: 20px;
        }

        .role-create-actions {
            flex-direction: column;
        }

        .role-create-actions button,
        .role-create-actions a {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="container role-create-page">

    <!-- Encabezado -->
    <div class="role-create-header">
        <h2>Crear rol</h2>
        <p>
            Registra un nuevo rol y configura los permisos que tendrá dentro de MotoFix.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-10">

            <div class="role-create-card">

                <!-- Cabecera -->
                <div class="role-create-card-header">
                    <h4>Configuración del rol</h4>
                    <p>
                        Define el nombre y selecciona las funcionalidades
                        a las que podrá acceder este rol.
                    </p>
                </div>

                <div class="role-create-card-body">

                    <form asp-controller="Roles"
                          asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <!-- Nombre del rol -->
                        <h5 class="role-create-section-title">
                            Información general
                        </h5>

                        <div class="mb-4">

                            <label asp-for="Nombre"
                                   class="form-label role-create-label">
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control role-create-control"
                                   placeholder="Ejemplo: Supervisor" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger small">
                            </span>

                            <div class="role-create-help">
                                Ingresa un nombre que permita identificar
                                claramente la función de este rol.
                            </div>

                        </div>

                        <!-- Permisos -->
                        <h5 class="role-create-section-title">
                            Permisos disponibles
                        </h5>

                        <div class="role-create-info">
                            <strong>Control de acceso:</strong>
                            selecciona los permisos que tendrá este rol.
                            Los usuarios asignados heredarán estas autorizaciones.
                        </div>

                        @if (Model.PermisosDisponibles.Any())
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0 fw-bold text-dark">
                                    Selección de permisos
                                </h6>

                                <span class="permission-counter">
                                    @Model.PermisosDisponibles.Count permisos disponibles
                                </span>
                            </div>

                            <div class="row">

                                @foreach (var permiso in Model.PermisosDisponibles)
                                {
                                    <div class="col-md-6 col-lg-4 mb-3">

                                        <div class="permission-card">

                                            <div class="form-check">

                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="PermisosSeleccionados"
                                                       value="@permiso.Id"
                                                       id="permiso_@permiso.Id"
                                                       checked="@Model.PermisosSeleccionados.Contains(permiso.Id)" />

                                                <label class="form-check-label"
                                                       for="permiso_@permiso.Id">

                                                    <span class="permission-name">
                                                        @permiso.Nombre
                                                    </span>

                                                    <span class="permission-description">
                                                        @permiso.Descripcion
                                                    </span>

                                                </label>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <strong>Sin permisos disponibles.</strong>
                                No hay permisos registrados para asignar a este rol.
                            </div>
                        }

                        <!-- Botones -->
                        <hr class="my-4" />

                        <div class="d-flex justify-content-between gap-3 role-create-actions">

                            <a asp-controller="Roles"
                               asp-action="Index"
                               class="role-create-cancel">
                                ← Volver a roles
                            </a>

                            <button type="submit"
                                    class="role-create-submit">
                                + Crear rol
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
