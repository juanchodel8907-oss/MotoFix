@model IEnumerable<MotoFix.Models.Motocicleta>

@{
    ViewData["Title"] = "Motocicletas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Motocicletas</h1>

        <a asp-action="Create" class="btn btn-primary">
            Nueva Motocicleta
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay motocicletas registradas todavía.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Placa</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Cilindraje</th>
                        <th>Propietario</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var motocicleta in Model)
                    {
                        <tr>
                            <td>@motocicleta.Placa</td>
                            <td>@motocicleta.Marca</td>
                            <td>@motocicleta.Modelo</td>
                            <td>@motocicleta.Cilindraje cc</td>
                            <td>
                                @motocicleta.Cliente?.Nombre
                                @motocicleta.Cliente?.Apellido
                            </td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@motocicleta.Id"
                                   class="btn btn-info btn-sm">
                                    Ver
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@motocicleta.Id"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@motocicleta.Id"
                                   class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>