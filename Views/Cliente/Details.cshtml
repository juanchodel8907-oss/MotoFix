@model MotoFix.Models.Cliente

@{
    ViewData["Title"] = "Detalles del Cliente";
}

<div class="container mt-4">
    <h1>Detalles del Cliente</h1>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            Nombre completo
        </dt>
        <dd class="col-sm-9">
            @Model.Nombre @Model.Apellido
        </dd>

        <dt class="col-sm-3">
            Documento
        </dt>
        <dd class="col-sm-9">
            @Model.Documento
        </dd>

        <dt class="col-sm-3">
            Teléfono
        </dt>
        <dd class="col-sm-9">
            @Model.Telefono
        </dd>

        <dt class="col-sm-3">
            Correo
        </dt>
        <dd class="col-sm-9">
            @Model.Correo
        </dd>

        <dt class="col-sm-3">
            Motocicletas registradas
        </dt>
        <dd class="col-sm-9">
            @if (Model.Motocicletas.Any())
            {
                <ul>
                    @foreach (var motocicleta in Model.Motocicletas)
                    {
                        <li>
                            @motocicleta.Marca @motocicleta.Modelo
                            - Placa: @motocicleta.Placa
                        </li>
                    }
                </ul>
            }
            else
            {
                <span>No tiene motocicletas registradas.</span>
            }
        </dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Editar
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Volver a Clientes
        </a>
    </div>
</div>