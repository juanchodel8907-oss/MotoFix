
@model IEnumerable<MotoFix.Models.Cliente>

@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Gestión de clientes";

    bool puedeCrear = (await AuthorizationService.AuthorizeAsync(
        User, null, "Clientes.Crear")).Succeeded;

    bool puedeVer = (await AuthorizationService.AuthorizeAsync(
        User, null, "Clientes.Ver")).Succeeded;

    bool puedeEditar = (await AuthorizationService.AuthorizeAsync(
        User, null, "Clientes.Editar")).Succeeded;

    bool puedeEliminar = (await AuthorizationService.AuthorizeAsync(
        User, null, "Clientes.Eliminar")).Succeeded;

    int totalClientes = Model.Count();
    int totalMotocicletas = Model.Sum(c => c.Motocicletas?.Count ?? 0);
}

<style>
    .clientes-page {
        padding: 20px 0 40px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-title {
        color: #172b4d;
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .page-subtitle {
        color: #718096;
        margin-bottom: 0;
    }

    .btn-motofix {
        background: #1765c1;
        color: white;
        border: none;
        border-radius: 9px;
        padding: 11px 18px;
        font-weight: 650;
        text-decoration: none;
        transition: background 0.2s ease;
    }

    .btn-motofix:hover {
        background: #104b91;
        color: white;
    }

    .summary-card {
        background: white;
        border: 1px solid #e8edf4;
        border-radius: 13px;
        padding: 19px 22px;
        height: 100%;
        box-shadow: 0 4px 14px rgba(20, 40, 70, 0.035);
    }

    .summary-label {
        color: #718096;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .summary-value {
        color: #173b70;
        font-size: 27px;
        font-weight: 800;
        margin: 0;
    }

    .table-panel {
        background: white;
        border: 1px solid #e8edf4;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(20, 40, 70, 0.045);
    }

    .table-panel-header {
        padding: 20px 22px;
        border-bottom: 1px solid #e8edf4;
    }

    .table-panel-title {
        color: #1b2d49;
        font-size: 18px;
        font-weight: 750;
        margin: 0;
    }

    .clientes-table {
        margin-bottom: 0;
        vertical-align: middle;
    }

    .clientes-table thead th {
        background: #f3f6fb;
        color: #53647c;
        font-size: 12px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 15px 16px;
        border-bottom: 1px solid #e5ebf3;
        white-space: nowrap;
    }

    .clientes-table tbody td {
        color: #46566d;
        font-size: 14px;
        padding: 16px;
        border-bottom: 1px solid #edf1f6;
    }

    .clientes-table tbody tr:last-child td {
        border-bottom: none;
    }

    .clientes-table tbody tr:hover {
        background: #f8faff;
    }

    .client-name {
        color: #1b2d49;
        font-weight: 700;
    }

    .motorcycle-count {
        display: inline-block;
        min-width: 30px;
        padding: 5px 9px;
        border-radius: 20px;
        background: #eaf2ff;
        color: #1765c1;
        font-weight: 750;
        text-align: center;
    }

    .action-btn {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        margin: 2px;
    }

    .action-view {
        color: #1765c1;
        background: #eaf2ff;
    }

    .action-edit {
        color: #95620c;
        background: #fff3d6;
    }

    .action-delete {
        color: #b42332;
        background: #fdebed;
    }

    .action-btn:hover {
        filter: brightness(0.95);
    }

    .empty-state {
        padding: 55px 20px;
        text-align: center;
    }

    .empty-icon {
        font-size: 38px;
        margin-bottom: 14px;
    }

    .empty-title {
        color: #1b2d49;
        font-size: 19px;
        font-weight: 750;
    }

    .empty-description {
        color: #718096;
        margin-bottom: 0;
    }

    @@media (max-width: 768px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-title {
            font-size: 25px;
        }
    }
</style>

<div class="container clientes-page">

    <div class="page-header">
        <div>
            <h1 class="page-title">Gestión de clientes</h1>
            <p class="page-subtitle">
                Administra la información de los clientes registrados en MotoFix.
            </p>
        </div>

        @if (puedeCrear)
        {
            <a asp-action="Create" class="btn-motofix">
                + Nuevo cliente
            </a>
        }
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="summary-card">
                <div class="summary-label">Clientes registrados</div>
                <p class="summary-value">@totalClientes</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="summary-card">
                <div class="summary-label">Motocicletas asociadas</div>
                <p class="summary-value">@totalMotocicletas</p>
            </div>
        </div>

    </div>

    <section class="table-panel">

        <div class="table-panel-header">
            <h2 class="table-panel-title">Listado de clientes</h2>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">👥</div>

                <h3 class="empty-title">
                    No hay clientes registrados
                </h3>

                <p class="empty-description">
                    Los clientes que registres aparecerán en este espacio.
                </p>

                @if (puedeCrear)
                {
                    <a asp-action="Create"
                       class="btn-motofix d-inline-block mt-3">
                        Registrar primer cliente
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table clientes-table">

                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Documento</th>
                            <th>Teléfono</th>
                            <th>Correo electrónico</th>
                            <th>Motocicletas</th>

                            @if (puedeVer || puedeEditar || puedeEliminar)
                            {
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var cliente in Model)
                        {
                            <tr>
                                <td>
                                    <span class="client-name">
                                        @cliente.Nombre @cliente.Apellido
                                    </span>
                                </td>

                                <td>@cliente.Documento</td>

                                <td>@cliente.Telefono</td>

                                <td>@cliente.Correo</td>

                                <td>
                                    <span class="motorcycle-count">
                                        @(cliente.Motocicletas?.Count ?? 0)
                                    </span>
                                </td>

                                @if (puedeVer || puedeEditar || puedeEliminar)
                                {
                                    <td>
                                        @if (puedeVer)
                                        {
                                            <a asp-action="Details"
                                               asp-route-id="@cliente.Id"
                                               class="action-btn action-view">
                                                Ver
                                            </a>
                                        }

                                        @if (puedeEditar)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@cliente.Id"
                                               class="action-btn action-edit">
                                                Editar
                                            </a>
                                        }

                                        @if (puedeEliminar)
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@cliente.Id"
                                               class="action-btn action-delete">
                                                Eliminar
                                            </a>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }

    </section>

</div>
